# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/accountable
DB_ECHO=false

# SMTP (fill in for escalation notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@accountable.gov.in

# Default authority contacts
DEFAULT_WARD_OFFICER_EMAIL=ward.officer@municipality.gov.in
DEFAULT_MLA_EMAIL=mla.office@assembly.gov.in
DEFAULT_COLLECTOR_EMAIL=collector@district.gov.in
DEFAULT_STATE_AUTHORITY_EMAIL=grievance@state.gov.in

# RTI
RTI_PDF_DIR=./rti_pdfs
DEFAULT_PIO_ADDRESS=The Public Information Officer, Concerned Department, Government of India
